    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lp.Infrastructure\lp.Infrastructure.csproj" />
    <ProjectReference Include="..\lp.Domain\lp.Domain.csproj" />
  </ItemGroup>

